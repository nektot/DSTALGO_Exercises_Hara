//CHALLENGE NUMBER 2 - Guess the Secret Number
namespace WhileFormApp
{
    public partial class Form2 : Form
    {
        public Form2()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int secret = 7;
            int guess = Convert.ToInt32(txtGuess.Text);

            while (guess != secret)
            {
                lblMessage.Text = ("Wrong guess! Try again.");
                return;
            }
            lblMessage.Text = "Congratulations! You guessed the secret number of diamonds.";
        }
    }
}

// C# DO WHILE EXERCISES

// NUMBER 1 - Coin Collector
namespace WhileFormApp
{
    public partial class Form3 : Form
    {
        public Form3()
        {
            InitializeComponent();
        }

        private void btnMine_Click(object sender, EventArgs e)
        {
            int coins = 0;

            do
            {
                coins += 10;
            }
            while (coins < 100);
            lblDiamond.Text = "Diamonds: " + coins;
        }
    }
}

// NUMBER 2 - Monster Battle
namespace WhileFormApp
{
    public partial class Form4 : Form
    {
        public Form4()
        {
            InitializeComponent();
        }

        private void btnFight_Click(object sender, EventArgs e)
        {
            int hp = 50;
            string result = "";

            do
            {
                hp -= 10;
                result += "Enemy HP: " + hp + "\n";
            }
            while (hp > 0);
            result +=  "Enemy defeated!";
            lblResult.Text = result;
        }
    }
}

// C# SWITCH

// NUMBER 1 - Choose a Weapon
namespace WhileFormApp
{
    public partial class Form5 : Form
    {
        public Form5()
        {
            InitializeComponent();
        }

        private void btnFight_Click(object sender, EventArgs e)
        {
            string weapon = cmbWeapon.Text;

            switch (weapon)
            {
                case "Sword":
                    lblResult.Text = "⚔️ You attacked with a Sword!";
                    break;

                case "Bow":
                    lblResult.Text = "🏹 You attacked with a Bow!";
                    break;

                case "Magic":
                    lblResult.Text = "✨ You cast a Magic Spell!";
                    break;

                default:
                    lblResult.Text = "Select a weapon first!";
                    break;
            }

        }
    }
}

// NUMBER 2 - Choose a Door
namespace WhileFormApp
{
    public partial class Form6 : Form
    {
        public Form6()
        {
            InitializeComponent();
        }

        private void btnOpen_Click(object sender, EventArgs e)
        {
            int door = Convert.ToInt32(txtDoor.Text);

            switch (door)
            {
                case 1:
                    lblResult.Text = "💰 You found treasure!";
                    break;

                case 2:
                    lblResult.Text = "👾 A monster appeared!";
                    break;

                case 3:
                    lblResult.Text = "🧪 You found a magic potion!";
                    break;

                default:
                    lblResult.Text = "Choose Door 1, 2, or 3.";
                    break;
            }

        }
    }
}

// C# For Statement Exercises

// NUMBER 1 - Heart Collector
namespace WhileFormApp
{
    public partial class Form7 : Form
    {
        public Form7()
        {
            InitializeComponent();
        }

        private void btnHeal_Click(object sender, EventArgs e)
        {
            progressBar1.Value = 0;

            for (int health = 0; health <= 100; health += 20)
            {
                progressBar1.Value = health;
                lblHealth.Text = $"Health: {health}%";
                Application.DoEvents();
                System.Threading.Thread.Sleep(300);
            }
            MessageBox.Show("Full Health!");
        }
    }
}

